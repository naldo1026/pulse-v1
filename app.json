{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0716"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pulse.app"
    },
    "android": {
      "package": "com.pulse.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0716"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-font"
    ]
  }
}
