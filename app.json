{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F6F4EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pulse.app"
    },
    "android": {
      "package": "com.pulse.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F4EF"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "baseUrl": "/pulse-v1"
    }
  }
}
