# Copy to .env (gitignored) and fill in. Set the same three in Vercel.
# Expo inlines EXPO_PUBLIC_* into the web bundle at build time, so only put
# public values here. The service-role key and VAPID private key go in
# Supabase secrets, never here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
